#!/usr/bin/python3.11
"""T3 Code adapter over rolelive: set this as a T3 Claude provider instance's binary path.

T3 thinks it runs `claude --input-format stream-json ...` (Agent SDK protocol). This program translates that protocol
to and from a rolelive.LiveSession, i.e. a claude already running in tmux. It never starts claude on the session.
  --version, or argv without --session-id/--resume (T3's health probe): exec the real claude unchanged.
  otherwise: mirror the role named by --bridge-role (launch args), starting it with --bridge-start if it isn't running.
"""
import base64, json, os, sys, threading, time, uuid

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import rolelive  # noqa: E402

REAL_CLAUDE = os.environ.get("T3_BRIDGE_CLAUDE", "claude")
LOG_DIR = os.environ.get("T3_BRIDGE_LOG_DIR", os.path.join(rolelive.HOME, ".cache", "t3-bridge"))
VALUE_FLAGS = {"--output-format", "--input-format", "--thinking", "--thinking-display", "--effort", "--model",
               "--permission-prompt-tool", "--allowedTools", "--disallowedTools", "--tools", "--permission-mode",
               "--add-dir", "--session-id", "--resume", "--settings", "--setting-sources", "--append-system-prompt",
               "--max-turns", "--fallback-model", "--mcp-config", "--max-thinking-tokens", "--bridge-role",
               "--bridge-start"}
BOOL_FLAGS = {"--verbose", "--include-partial-messages", "--allow-dangerously-skip-permissions",
              "--strict-mcp-config", "--dangerously-skip-permissions", "--no-session-persistence"}
# Flags T3 always sends that the live session can't (or needn't) honour: logged, not shown.
EXPECTED_FLAGS = {"--output-format", "--input-format", "--verbose", "--include-partial-messages", "--session-id",
                  "--resume", "--thinking", "--thinking-display", "--strict-mcp-config", "--bridge-role",
                  "--bridge-start", "--allow-dangerously-skip-permissions", "--dangerously-skip-permissions",
                  "--model", "--effort", "--permission-mode", "--permission-prompt-tool", "--allowedTools", "--tools",
                  "--add-dir", "--settings", "--setting-sources"}


def parse_argv(argv):
    flags, unknown, i = {}, [], 0
    while i < len(argv):
        name, eq, inline = argv[i].partition("=")
        if name in VALUE_FLAGS:
            if not eq:
                i += 1
                inline = argv[i] if i < len(argv) else ""
            flags.setdefault(name, []).append(inline)
        elif argv[i] in BOOL_FLAGS:
            flags[argv[i]] = [True]
        else:
            unknown.append(argv[i])
        i += 1
    return flags, unknown


def strip_bridge_flags(argv):
    out, skip = [], False
    for a in argv:
        if skip or a.startswith(("--bridge-role=", "--bridge-start=")):
            skip = False
            continue
        skip = a in ("--bridge-role", "--bridge-start")
        if not skip:
            out.append(a)
    return out


class Bridge:
    def __init__(self, flags, unknown):
        self.flags, self.unknown = flags, unknown
        self.role = (flags.get("--bridge-role") or [""])[0]
        os.makedirs(LOG_DIR, exist_ok=True)
        self.logf = open(os.path.join(LOG_DIR, f"bridge-{self.role or 'unknown'}.log"), "a", buffering=1)
        self.out = threading.Lock()
        self.lock = threading.RLock()
        self.model = (flags.get("--model") or ["unknown"])[0]
        self.permission_mode = (flags.get("--permission-mode") or ["default"])[0]
        self.turn = None            # {"t3_uuid", "started", "last_text"}: the T3 turn the stream is inside
        self.routable = False       # T3 routes unsolicited (wake) turns only after one of its own on this process
        self.pending_notices = []
        self.requests = {}          # can_use_tool request_id -> dialog id
        self.by_dialog = {}

    def log(self, *a):
        self.logf.write(time.strftime("%H:%M:%S ") + " ".join(str(x) for x in a) + "\n")

    def emit(self, obj):
        line = json.dumps(obj, separators=(",", ":"))
        with self.out:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        self.log("OUT", line[:300])

    # ---- stream-json frames ----
    def init_frame(self, t3_uuid):
        f = {"type": "system", "subtype": "init", "cwd": self.s.live["cwd"], "session_id": self.s.session_id,
             "tools": [], "mcp_servers": [], "model": self.model, "permissionMode": self.permission_mode,
             "slash_commands": [], "apiKeySource": "none", "claude_code_version": self.s.live.get("version", ""),
             "output_style": "default", "agents": [], "skills": [], "plugins": [], "uuid": str(uuid.uuid4())}
        if t3_uuid:
            f["user_message_uuids"] = [t3_uuid]   # early prompt echo: binds the frames to T3's own turn
        return f

    def assistant(self, block, meta=None, uid=None):
        meta = meta or {"id": "msg_bridge_" + uuid.uuid4().hex[:16], "type": "message", "role": "assistant",
                        "model": self.model, "stop_reason": None, "usage": {"input_tokens": 0, "output_tokens": 0}}
        self.emit({"type": "assistant", "message": {**meta, "content": [block]}, "parent_tool_use_id": None,
                   "session_id": self.s.session_id, "uuid": uid or str(uuid.uuid4())})

    def text(self, text):
        self.assistant({"type": "text", "text": text})

    def open_turn(self, t3_uuid):
        self.turn = {"t3_uuid": t3_uuid, "started": time.time(), "last_text": ""}
        self.emit(self.init_frame(t3_uuid))
        for n in self.pending_notices:
            self.text(f"⚠ bridge: {n}")
        self.pending_notices = []

    def close_turn(self, interrupted=False):
        t, self.turn = self.turn, None
        if t is None:
            return
        r = {"type": "result", "subtype": "success", "is_error": False, "num_turns": 1,
             "duration_ms": int((time.time() - t["started"]) * 1000), "duration_api_ms": 0,
             "result": t["last_text"], "stop_reason": None if interrupted else "end_turn",
             "session_id": self.s.session_id, "total_cost_usd": 0, "modelUsage": {}, "permission_denials": [],
             "usage": {"input_tokens": 0, "output_tokens": 0, "cache_creation_input_tokens": 0,
                       "cache_read_input_tokens": 0}, "uuid": str(uuid.uuid4())}
        if t["t3_uuid"]:
            r["user_message_uuids"] = [t["t3_uuid"]]
        self.emit(r)

    def notice(self, text):
        """Fail loudly: log, and show in the thread now, as a one-line turn, or at the next turn."""
        self.log("NOTICE", text)
        with self.lock:
            if self.turn is not None:
                self.text(f"⚠ bridge: {text}")
            elif self.routable:
                self.open_turn(None)
                self.text(f"⚠ bridge: {text}")
                self.close_turn()
            else:
                self.pending_notices.append(text)

    # ---- core events -> T3 ----
    def on_event(self, ev):
        k = ev["kind"]
        with self.lock:
            if k == "notice":
                return self.notice(ev["text"])
            if k == "session":
                self.log("session", ev)
                if ev["switched"]:
                    self.notice(f"live session switched to {ev['session_id']} (/clear or restart); following it")
                return
            if k == "turn_start":
                if self.turn is not None and self.turn["t3_uuid"] and not self.turn.get("landed"):
                    self.turn["landed"] = True
                    if not ev["by_us"]:   # a tmux/RC prompt raced T3's: both run inside T3's turn
                        self.log("race: first prompt in T3's turn was not T3's:", ev["text"][:80])
                    return
                if self.turn is not None:
                    self.close_turn()   # a new prompt ends whatever was open
                self.open_turn(None)
                label = {"human": "typed in tmux/RC", "peer": f"peer {ev.get('peer') or ''}".strip()}.get(
                    ev["origin"], ev["origin"])
                body = ev["text"] if len(ev["text"]) < 600 else ev["text"][:600] + "…"
                return self.text(f"› ({label}) " + body.replace("\n", "\n› "))
            if k == "turn_end":
                if self.turn is not None:
                    self.turn["last_text"] = ev["last_text"]
                return self.close_turn(ev["reason"] == "interrupted")
            if self.turn is None:
                self.open_turn(None)
            if k in ("text", "thinking", "tool_use"):
                return self.assistant(ev["block"], ev["message"], ev.get("uuid"))
            if k == "tool_result":
                return self.emit({"type": "user", "message": {"role": "user", "content": [ev["block"]]},
                                  "parent_tool_use_id": None, "session_id": self.s.session_id,
                                  "uuid": ev.get("uuid"), "tool_use_result": ev.get("tool_use_result")})
            if k == "dialog_open":
                rid = str(uuid.uuid4())
                self.requests[rid], self.by_dialog[ev["id"]] = ev["id"], rid
                return self.emit({"type": "control_request", "request_id": rid, "request": {
                    "subtype": "can_use_tool", "tool_name": ev["tool"], "display_name": ev["tool"],
                    "input": ev["input"], "tool_use_id": ev["id"],
                    "requires_user_interaction": ev["dialog"] == "question"}})
            if k == "dialog_closed":
                rid = self.by_dialog.pop(ev["id"], None)
                if rid and ev["by"] == "elsewhere":   # answered in tmux or RC: close T3's dialog
                    self.requests.pop(rid, None)
                    self.emit({"type": "control_cancel_request", "request_id": rid})
                return
            self.notice(f"core event {k!r} not mapped")

    # ---- T3 -> core ----
    def reply(self, rid, response=None, error=None):
        r = {"subtype": "error", "request_id": rid, "error": error} if error else \
            {"subtype": "success", "request_id": rid, "response": response or {}}
        self.emit({"type": "control_response", "response": r})

    def on_control(self, msg):
        req, rid = msg.get("request", {}), msg.get("request_id")
        st = req.get("subtype")
        if st == "initialize":
            self.log("known gap: T3's appendSystemPrompt doesn't reach the live session")
            self.reply(rid, {"commands": [], "agents": [], "output_style": "default", "available_output_styles": [],
                             "models": [], "account": {}, "pid": self.s.live["pid"],
                             "claude_code_version": self.s.live.get("version", ""),
                             "current_permission_mode": self.permission_mode, "capabilities": []})
        elif st == "mcp_set_servers":
            names = list(req.get("servers", {}))
            self.log(f"known gap: T3 MCP servers {names} are not available in the live session")
            self.reply(rid, {"added": names, "removed": [], "errors": {}})
        elif st == "set_model":
            self.s.set_model(req.get("model"))   # refused by the core with a notice (it would persist)
            self.reply(rid)
        elif st == "apply_flag_settings":
            s = {k: v for k, v in req.get("settings", {}).items() if v is not None}
            if "effortLevel" in s:
                self.s.set_effort(s.pop("effortLevel"))
            if s:
                self.notice(f"settings not applied to the live session: {json.dumps(s)}")
            self.reply(rid)
        elif st == "set_permission_mode":
            if req.get("mode") != self.permission_mode:
                self.notice(f"permission mode {req.get('mode')} not applied; the live session keeps its own")
            self.reply(rid)
        elif st == "interrupt":
            self.s.interrupt()
            self.reply(rid)
        else:
            self.notice(f"unsupported control request {st!r} answered with an error")
            self.reply(rid, error=f"t3-tmux-bridge: unsupported control request {st}")

    def on_control_response(self, msg):
        resp = msg.get("response", {})
        did = self.requests.pop(resp.get("request_id"), None)
        if did is None:
            return self.log("control_response for unknown request", resp.get("request_id"))
        self.by_dialog.pop(did, None)
        body = resp.get("response") or {}
        if resp.get("subtype") != "success" or body.get("behavior") != "allow":
            return self.s.answer(did, "deny")
        answers = (body.get("updatedInput") or {}).get("answers")
        self.s.answer(did, answers if answers is not None else "allow")

    def on_user(self, msg):
        content, files = msg["message"]["content"], []
        text = content
        if isinstance(content, list):
            parts = []
            for b in content:
                src = b.get("source") or {}
                if b.get("type") == "text":
                    parts.append(b["text"])
                elif b.get("type") in ("image", "document") and src.get("type") == "base64":
                    ext = {"image/png": "png", "image/jpeg": "jpg", "image/gif": "gif", "image/webp": "webp",
                           "application/pdf": "pdf"}.get(src.get("media_type"), "bin")
                    d = os.path.join(LOG_DIR, "attachments")
                    os.makedirs(d, mode=0o700, exist_ok=True)
                    p = os.path.join(d, f"{uuid.uuid4().hex}.{ext}")
                    with open(p, "wb") as f:
                        f.write(base64.b64decode(src["data"]))
                    files.append(p)
                else:
                    self.notice(f"message part of type {b.get('type')!r} dropped")
            text = "\n".join(parts)
        with self.lock:
            self.routable = True
            if self.turn is not None:
                self.notice("T3 message sent while a turn was running; the live session queues it")
            else:
                self.open_turn(msg.get("uuid") or str(uuid.uuid4()))
        self.s.send(text, files)

    def run(self):
        start = (self.flags.get("--bridge-start") or [None])[0]
        self.s = rolelive.LiveSession.attach(role=self.role, start_cmd=start)
        self.log("attached", self.role, self.s.session_id, "pane", self.s.pane, "pid", self.s.live["pid"])
        for a in self.unknown:
            self.notice(f"unknown argument {a!r} ignored")
        for k, v in self.flags.items():
            (self.log if k in EXPECTED_FLAGS else self.notice)(f"flag {k} {v} not applied to the live session")
        self.s.on_event = self.on_event
        self.s.start()
        for line in sys.stdin:
            if not line.strip():
                continue
            self.log("IN", line[:300].rstrip())
            try:
                msg = json.loads(line)
                t = msg.get("type")
                if t == "control_request":
                    self.on_control(msg)
                elif t == "control_response":
                    self.on_control_response(msg)
                elif t == "user":
                    self.on_user(msg)
                elif t == "control_cancel_request":
                    self.log("cancel", msg)
                else:
                    self.notice(f"unknown input message type {t!r}")
            except Exception as e:   # a bridge bug must never hang T3
                self.log("ERROR", repr(e))
                self.notice(f"bridge error: {e!r}")
                if '"control_request"' in line:
                    self.reply(json.loads(line).get("request_id"), error=repr(e))
        self.log("stdin closed; detaching (the tmux session is untouched)")
        self.s.close()
        os._exit(0)


def main():
    argv = sys.argv[1:]
    flags, unknown = parse_argv(argv)
    if "--version" in argv or not ({"--session-id", "--resume"} & set(flags)):
        os.execvp(REAL_CLAUDE, [REAL_CLAUDE] + strip_bridge_flags(argv))
    Bridge(flags, unknown).run()


if __name__ == "__main__":
    main()
