{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "python3.11 \"$HOME/.claude/shared/hooks/routing_gate.py\" session-start 2>/dev/null || true", "timeout": 2 }] }],
    "PreToolUse": [{ "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "python3.11 \"$HOME/.claude/shared/agent-mail/agent_mail.py\" decide-hook pre 2>/dev/null || true", "timeout": 2 }] },
      { "matcher": "PushNotification", "hooks": [{ "type": "command", "command": "python3.11 \"$HOME/.claude/shared/agent-mail/agent_mail.py\" decide-hook push 2>/dev/null || true", "timeout": 2 }] },
      { "matcher": "Agent", "hooks": [{ "type": "command", "command": "python3.11 \"$HOME/.claude/shared/hooks/routing_gate.py\" pre 2>/dev/null || true", "timeout": 2 }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "python3.11 \"$HOME/.claude/shared/hooks/routing_gate.py\" pre 2>/dev/null || true", "timeout": 2 }] }],
    "PostToolUse": [{ "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "python3.11 \"$HOME/.claude/shared/agent-mail/agent_mail.py\" decide-hook post 2>/dev/null || true", "timeout": 2 }] }]
  }
}
